      ],
      "steps": [
        {
          "name": "reshape_long",
          "path": "recipes/pwt_panel/01_reshape_long.py",
          "description": "Reshape the wide export (one column per year) into one row per country, variable and year."
        },
        {
          "name": "keep_core_variables",
          "path": "recipes/pwt_panel/02_keep_core_variables.py",
          "description": "Keep eight core variables: three measures of GDP, population, employment, hours worked, human capital and TFP."
        },
        {
          "name": "pivot_to_panel",
          "path": "recipes/pwt_panel/03_pivot_to_panel.py",
