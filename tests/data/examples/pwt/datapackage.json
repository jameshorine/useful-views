        {
          "name": "derive_measures",
          "path": "recipes/gdp_per_capita/01_derive_measures.py",
          "description": "Compute GDP per capita (rgdpe / pop, in 2021 US$), its annual growth in percent (from rgdpna / pop, the series PWT recommends for growth over time), and its level relative to the United States in the same year."
        }
      ]
    },
    {
      "name": "pwt_panel",
